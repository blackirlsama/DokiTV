# Non-secret deployment template. manage.py init creates a private copy outside the repository.
TIANMU_STACK_NAME=tianmu-staging
TIANMU_SECRETS_DIR=/opt/tianmu-staging/config/secrets
TIANMU_IMAGE_TAG=unbuilt
AGENT_HTTP_PORT=18201
AGENT_MEMORY_LIMIT=768m
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4
MAVEN_IMAGE=maven:3.10.0-eclipse-temurin-17
JAVA_IMAGE=eclipse-temurin:17-jre-jammy
# Optional business mode; the model key is a private file, not an environment-file literal.
BUSINESS_BASE_URL=
