# TEMPLATE ONLY. Spring and the Java utilities do NOT automatically load .env.
# Set process environment variables; see docs/DEPLOYMENT.md. Never commit real values.
# Demo: none of these variables is required.

# Existing video backend (requires all middleware and the real schema)
TIANMU_JDBC_URL=jdbc:mysql://127.0.0.1:3306/tianmu?serverTimezone=Asia/Shanghai
TIANMU_DB_USER=tianmu
TIANMU_DB_PASSWORD=
TIANMU_REDIS_HOST=127.0.0.1
TIANMU_REDIS_PORT=6379
TIANMU_REDIS_DATABASE=0
TIANMU_REDIS_PASSWORD=
TIANMU_ES_URL=http://127.0.0.1:9200
TIANMU_ES_USER=
TIANMU_ES_PASSWORD=
TIANMU_MINIO_URL=http://127.0.0.1:9000
TIANMU_MINIO_ACCESS_KEY=
TIANMU_MINIO_SECRET_KEY=
TIANMU_MINIO_BUCKET=tianmu-upload
TIANMU_ROCKETMQ_NAMESERVER=127.0.0.1:9876
TIANMU_CANAL_HOST=127.0.0.1
TIANMU_CANAL_PORT=11111
TIANMU_CANAL_DESTINATION=example
TIANMU_CANAL_USER=canal
TIANMU_CANAL_PASSWORD=
TIANMU_SMTP_HOST=smtp.qq.com
TIANMU_SMTP_USER=
TIANMU_SMTP_PASSWORD=
# Generate >=32 random bytes, Base64 encode; use the SAME private value in login and bridge.
JWT_SECRET_BASE64=

# Optional real model provider (the deepseek profile makes paid outbound requests)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PREPARATION_MODEL=deepseek-flash
HARNESS_MODEL=deepseek-v4-pro

# Agent-owned storage. Separate from the business database.
AGENT_JDBC_URL=jdbc:mysql://127.0.0.1:3307/Tianmu_agent?serverTimezone=UTC
AGENT_DB_USER=agent
AGENT_DB_PASSWORD=
AGENT_MYSQL_ROOT_PASSWORD=
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6380
AGENT_REDIS_PASSWORD=
AGENT_OBJECT_DIRECTORY=./var/artifacts

# Authenticated business bridge (optional)
BUSINESS_BASE_URL=http://127.0.0.1:8202
BUSINESS_JDBC_URL=
BUSINESS_DB_USER=
BUSINESS_DB_PASSWORD=
BUSINESS_REDIS_HOST=127.0.0.1
BUSINESS_REDIS_PORT=6379
BUSINESS_REDIS_PASSWORD=
# MUST match the login Redis database index.
BUSINESS_REDIS_DATABASE=0
BUSINESS_ACTIVE_USER_STATES=
BUSINESS_TENANT_ID=tianmu
BUSINESS_DATETIME_ZONE=Asia/Shanghai
